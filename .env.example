RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_secret_key_here
WEBHOOK_SECRET=your_webhook_secret_here
# Local (SQLite)
# DATABASE_URL=sqlite:///./drop.db
#
# Supabase Postgres (Project Settings → Database → Connection string → URI)
# Example:
# DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
# If your URI doesn't include it, SSL is enforced by the app.
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Direct video file URLs for rewarded unlock (MP4/WebM — not YouTube/Drive pages)
HOUSE_ADS_URL1=https://<PROJECT_REF>.supabase.co/storage/v1/object/public/house-ads/ad-1.mp4
HOUSE_ADS_URL2=https://<PROJECT_REF>.supabase.co/storage/v1/object/public/house-ads/ad-2.mp4
HOUSE_ADS_URL3=https://<PROJECT_REF>.supabase.co/storage/v1/object/public/house-ads/ad-3.mp4
